<link rel="icon" href="/assets/img/favicon.webp">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link
  href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;1,400&display=swap"
  rel="stylesheet"
>
<style>
  :root {
    --ink: #16191d;
    --ink-2: #3d434a;
    --ink-3: #69717a;
    --rule: #d9d5cc;
    --paper: #ffffff;
    --backdrop: #0f1114;
    --accent: #2c6c67;
    --accent-2: #43b4a0;
    --serif: "Fraunces", Georgia, "Times New Roman", serif;
    --sans: "IBM Plex Sans", "Helvetica Neue", Arial, sans-serif;
  }
  * {
    box-sizing: border-box;
  }
  html {
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }
  body {
    margin: 0;
    background: var(--backdrop);
    color: var(--ink);
    font-family: var(--sans);
    font-size: 9.6pt;
    line-height: 1.45;
    padding: 28px 16px 48px;
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  a:hover {
    color: var(--accent);
  }
  p,
  ul {
    margin: 0;
  }
  ul {
    padding: 0;
    list-style: none;
  }

  /* toolbar (screen only) */
  .toolbar {
    max-width: 210mm;
    margin: 0 auto 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    font-size: 13px;
    color: #aab2ba;
  }
  .toolbar a {
    color: #aab2ba;
  }
  .toolbar a:hover,
  .toolbar a[aria-current] {
    color: var(--accent-2);
  }
  .toolbar nav {
    display: flex;
    gap: 18px;
    align-items: center;
  }
  .toolbar .btn {
    color: var(--backdrop);
    background: var(--accent-2);
    padding: 7px 14px;
    border-radius: 999px;
    font-weight: 500;
  }
  .toolbar .btn:hover {
    color: var(--backdrop);
    background: #5fcab7;
  }

  /* sheet */
  .sheet {
    max-width: 210mm;
    margin: 0 auto;
    background: var(--paper);
    padding: 16mm 17mm 18mm;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.45);
  }

  /* header */
  .cv-head {
    padding-bottom: 10px;
    border-bottom: 1.5px solid var(--ink);
    margin-bottom: 4px;
  }
  h1 {
    font-family: var(--serif);
    font-weight: 600;
    font-size: 25pt;
    line-height: 1.05;
    letter-spacing: -0.01em;
    margin: 0;
  }
  .headline {
    margin-top: 4px;
    font-size: 11pt;
    color: var(--accent);
    font-weight: 500;
  }
  .contact {
    margin-top: 7px;
    display: flex;
    flex-wrap: wrap;
    gap: 2px 0;
    color: var(--ink-2);
    font-size: 8.8pt;
  }
  .contact li:not(:last-child)::after {
    content: "·";
    margin: 0 7px;
    color: var(--ink-3);
  }
  .contact a {
    color: var(--ink-2);
  }

  /* sections */
  h2 {
    font-family: var(--sans);
    font-size: 8.6pt;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 15px 0 6px;
    padding-bottom: 3px;
    border-bottom: 0.6pt solid var(--rule);
    break-after: avoid;
  }
  h3 {
    font-size: 8.8pt;
    font-weight: 600;
    color: var(--ink-2);
    margin: 9px 0 4px;
    break-after: avoid;
  }
  .lede {
    color: var(--ink-2);
  }

  /* entries: what on the left, when on the right */
  .entry {
    break-inside: avoid;
  }
  .entry + .entry {
    margin-top: 8px;
  }
  .entry-top {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    align-items: baseline;
  }
  .entry-top b {
    font-weight: 600;
  }
  .date {
    flex: none;
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .sub {
    color: var(--ink-3);
  }
  .sub a {
    color: var(--ink-3);
    border-bottom: 0.5pt solid var(--rule);
  }
  .bullets {
    margin-top: 3px;
  }
  .bullets li {
    position: relative;
    padding-left: 12px;
  }
  .bullets li + li {
    margin-top: 2px;
  }
  .bullets li::before {
    content: "";
    position: absolute;
    left: 2px;
    top: 0.62em;
    width: 4px;
    height: 1px;
    background: var(--ink-3);
  }
  strong {
    font-weight: 600;
  }

  /* one-line rows: text left, year right */
  .rows li {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    align-items: baseline;
    break-inside: avoid;
  }
  .rows li + li {
    margin-top: 3px;
  }

  /* publications */
  .bibliography {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .pub {
    margin-bottom: 6px;
    break-inside: avoid;
  }
  .pub-title {
    font-weight: 600;
  }
  .pub-meta {
    color: var(--ink-2);
  }
  .pub-meta b {
    color: var(--ink);
    font-weight: 600;
  }
  .pub-note {
    color: var(--accent);
    font-size: 8.8pt;
  }
  .status {
    color: var(--accent);
    font-weight: 500;
  }
  .more {
    margin-top: 6px;
    color: var(--ink-3);
  }
  .more a {
    border-bottom: 0.5pt solid var(--rule);
  }

  /* skills */
  .skills li + li {
    margin-top: 2px;
  }
  .skills b {
    font-weight: 600;
  }

  .updated {
    margin-top: 14px;
    color: var(--ink-3);
    font-size: 8pt;
  }

  @media (max-width: 640px) {
    .sheet {
      padding: 22px 18px;
    }
    .entry-top,
    .rows li {
      flex-direction: column;
      gap: 0;
    }
  }

  /* print: A4, running footer with name and page numbers */
  @page {
    size: A4;
    margin: 15mm 17mm 17mm;
    @bottom-left {
      content: "Mirko Casu · {{ include.doc_label }}";
      font-family: "IBM Plex Sans", Arial, sans-serif;
      font-size: 7.5pt;
      color: #69717a;
    }
    @bottom-right {
      content: counter(page) " / " counter(pages);
      font-family: "IBM Plex Sans", Arial, sans-serif;
      font-size: 7.5pt;
      color: #69717a;
    }
  }
  @media print {
    body {
      background: none;
      padding: 0;
    }
    .toolbar {
      display: none;
    }
    .sheet {
      max-width: none;
      padding: 0;
      box-shadow: none;
    }
    a:hover {
      color: inherit;
    }
  }
</style>
